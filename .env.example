# ═══════════════════════════════════════════════════════════════════
# POLYMARKET PAPER BOT — configuration (copier en .env, puis remplir)
# ═══════════════════════════════════════════════════════════════════
# NE JAMAIS commiter .env (ignoré par .gitignore). Toutes les variables sont optionnelles :
# une valeur absente garde son défaut, une valeur invalide est signalée au démarrage et par
# `npm run doctor` (jamais un 0 silencieux). Lecture unique : src/bot/config.ts.

# ── Mode et capital ──────────────────────────────────────────────
# Ce bot est PAPIER uniquement : l'exécution réelle n'est pas implémentée, aucun ordre ne
# peut partir. DRY_RUN=false est REFUSÉ au démarrage (pour ne jamais faire croire le contraire).
DRY_RUN=true
# Capital papier de référence (USDC). La mise est plafonnée à 1 % du capital actuel : il faut
# ≥ 100 $ pour atteindre le minimum Polymarket de 1 $ par ordre ; 250 $ recommandé.
PAPER_CAPITAL=250

# ── Porte de risque (fractions du capital de départ, PnL réalisé du registre) ──
# Perte du jour (UTC) : plus d'entrée jusqu'à minuit UTC.
DAILY_MAX_LOSS_PCT=0.05
# Perte du mois (UTC) : plus d'entrée jusqu'au 1er du mois suivant.
MONTHLY_MAX_LOSS_PCT=0.15
# Baisse depuis le plus haut : plus d'entrée jusqu'à décision manuelle (archiver le registre).
MAX_DRAWDOWN_PCT=0.25
# Perte totale : arrêt définitif des entrées.
TOTAL_MAX_LOSS_PCT=0.40

# ── Stratégie juste valeur (src/services/fair-value.ts) ─────────
# Achète un côté seulement si P(côté) calculée (spot vs prix à battre, vol, temps restant)
# dépasse son coût réel (VWAP + frais taker) d'au moins FV_MIN_EDGE + la marge de bruit.
FV_MIN_EDGE=0.04
# Marge en plus, en écarts-types du bruit de notre probabilité (prix à battre estimé,
# écart Binance/Chainlink) : edge exigé = FV_MIN_EDGE + FV_NOISE_EDGE_K·σ. 0 = désactivée
# (déconseillé : contre un carnet juste, le bruit seul fait parier à perte).
FV_NOISE_EDGE_K=1.5
# Probabilité modèle minimale du côté acheté (win rate attendu ≥ cette valeur).
FV_MIN_PROB=0.60
# Revente anticipée si (bid − frais) > p_modèle + FV_EXIT_EDGE + marge de bruit (défaut = FV_MIN_EDGE).
# FV_EXIT_EDGE=0.04
# Fenêtre d'entrée en secondes restantes (jamais dans la minute finale moyennée : TWAP).
FV_MIN_TAU_SEC=60
FV_MAX_TAU_SEC=270
# Bornes d'ask achetable.
FV_MIN_ASK=0.08
FV_MAX_ASK=0.92
# Frais taker crypto_fees_v2 (fee = parts · taux · p · (1−p)) et écart de flux (bps).
FV_TAKER_FEE_RATE=0.07
FV_BASIS_BPS=2
# Avancé (laisser par défaut) : bruit du prix à battre en secondes de variance ; fenêtre TWAP
# du règlement en s. Depuis août 2026, Polymarket règle sur la moyenne Chainlink des 60 s
# (fin ET prix à battre) : 60. 0 = ancien règlement ponctuel (faux aujourd'hui, le doctor le signale).
# FV_STRIKE_NOISE_SEC=3
# FV_TWAP_WINDOW_SEC=60
# Loi des rendements : normal | t4.
FV_TAILS=normal
# Estimateur de volatilité : cc (clôture-à-clôture, défaut) | parkinson (plus haut/plus bas) | blend.
# Les deux σ sont journalisés quoi qu'il arrive : changer seulement si fv-report.ts (section 1c) le valide.
# FV_VOL_ESTIMATOR=cc
# Mesure de la dernière minute des rounds (P(Up) avec la part déjà acquise du TWAP + carnet,
# journalisée, JAMAIS d'entrée ; rapport section 1d). false = économiser ces lectures de carnet.
# FV_LATE_MEASURE=true
# Calibration (1 = modèle brut) : ne changer que sur suggestion de scripts/analysis/fv-report.ts.
FV_Z_SCALE=1
# Mélange avec le carnet : logit(p) = FV_BLEND_MODEL·logit(p_modèle) + FV_BLEND_MARKET·logit(p_carnet).
# 1 / 0 = modèle seul. Ne changer que si fv-report.ts (section 1b) le valide hors échantillon.
FV_BLEND_MODEL=1
FV_BLEND_MARKET=0
# Passage régulier de la stratégie (s, 5–300).
FV_POLL_SEC=10
# Prix spot temps réel (WebSocket Binance) et seuil de réaction immédiate (points de base).
FV_SPOT_STREAM=true
FV_MOVE_BPS=3
# Avancé : autre point d'entrée du flux (proxy ; faux flux des tests), ws(s)://…/stream?streams=
# SPOT_STREAM_URL=
# Journal de toutes les évaluations (~/.polymarket/journal) pour scripts/analysis/fv-report.ts,
# et jours gardés (jours révolus compressés, ~1 Mo/jour).
FV_JOURNAL=true
FV_JOURNAL_KEEP_DAYS=30
# Coins tradés (défaut : BTC,ETH,SOL,XRP,DOGE).
# FV_COINS=BTC,ETH
# Latence d'exécution simulée (ms) : le carnet est relu après ce délai avant de « remplir ».
FV_FILL_DELAY_MS=1000
# Minimum d'un achat au marché Polymarket (USDC) ; un pari papier plus petit n'est pas pris.
FV_MIN_ORDER_USD=1
# Délai maximal des requêtes HTTP (ms) ; une API bloquée ne fige jamais le bot.
# HTTP_TIMEOUT_MS=10000

# ── Telegram (notifications intégrées au bot) ───────────────────
# Token de @BotFather et ton chat id (@userinfobot) ; un groupe commence par -100.
# Envoie /start à ton bot avant le premier lancement. `npx tsx scripts/telegram/check.ts` teste.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=false     # couper sans retirer le token
# TELEGRAM_SUMMARY_MIN=60    # bilan périodique (min, 15–1440)
# TELEGRAM_TZ=Europe/Paris   # fuseau des heures de round dans les messages
# TELEGRAM_COMMANDS=false    # ne plus répondre aux commandes /status /bilan /risque /positions /aide

# ── Dashboard ───────────────────────────────────────────────────
# Local uniquement par défaut. À distance : tunnel SSH, ou DASHBOARD_HOST=0.0.0.0 + un jeton
# (puis ouvrir http://serveur:3001/?token=<jeton>). Sans jeton hors local : repli sur 127.0.0.1.
# DASHBOARD_PORT=3001
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_TOKEN=
