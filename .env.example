# ═══════════════════════════════════════════════════════════════════
# POLYMARKET BOT — configuration (copie en .env puis remplit tes valeurs)
# ═══════════════════════════════════════════════════════════════════
# NE JAMAIS commiter .env — il est ignoré par .gitignore. Les clés restent
# privées. Copie ce fichier en .env et remplis.

# ── Wallet & mode ────────────────────────────────────────────────
# Clé privée du wallet Polymarket (Polygon). Placeholder en paper.
POLYMARKET_PRIVATE_KEY=your_private_key_here
# Capital virtuel de départ (paper).
CAPITAL_USD=50
# Capital PAPIER (prioritaire sur CAPITAL_USD en DRY_RUN). La mise est plafonnée à 1 % :
# il faut >= 100 $ pour atteindre le minimum Polymarket de 1 $ par ordre ; 250 $ recommandé.
PAPER_CAPITAL=250
# true = 100% paper (aucun ordre envoyé) · false = réel (RISQUÉ).
DRY_RUN=true

# RPC Polygon. polygon-rpc.com est souvent "API key disabled" → 1rpc.io fiable.
POLYGON_RPC_URL=https://1rpc.io/matic

# ── Stratégies (défaut off) ──────────────────────────────────────
ARBITRAGE_ENABLED=false
# DipArb = surveille les marchés BTC/ETH "Up or Down 5 minutes".
DIPARB_ENABLED=true
SMARTMONEY_ENABLED=false
TREND_ANALYSIS_ENABLED=false

# ── Gestion du risque (env-driven, voir bot-config.ts) ──────────
DAILY_MAX_LOSS_PCT=0.05      # perte max par jour (5%)
MONTHLY_MAX_LOSS_PCT=0.15    # perte max par mois (15%)
MAX_DRAWDOWN_PCT=0.25        # drawdown max (25%)
TOTAL_MAX_LOSS_PCT=0.40      # arrêt total (40%)

# ── Module d'analyse LLM (OpenAI-compatible) ────────────────────
# En DRY_RUN, le bot "réfléchit" via un LLM puis simule une mise de 1€.
# Sans clé (ou ENABLED=false) → mode dégradé 100% local : HOLD sûr.

# Clé API OpenAI-compatible (DeepSeek ou opencode-go/zen). Optionnelle.
DEEPSEEK_API_KEY=
DEEPSEEK_ANALYZER_ENABLED=true
DEEPSEEK_MODEL=deepseek-v4-flash
# Endpoint OpenAI-compatible. opencode-go/zen (même modèle que l'assistant).
DEEPSEEK_API_URL=https://opencode.ai/zen/go/v1/chat/completions
# Budget max d'appels LLM par jour (économisé : appelé seulement si edge fort).
DEEPSEEK_MAX_CALLS_PER_DAY=60
# Budget tokens par appel LLM (clampé). 4000 = max demandé.
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_MIN_TOKENS=4000
# Timeout de l'appel LLM (ms). 15000 car le modèle "réfléchit" 2-8s.
DEEPSEEK_TIMEOUT_MS=15000

# ── Stratégie juste valeur (src/services/fair-value.ts) ─────────
# Achète un côté seulement si P(côté) calculée (spot vs strike, vol, temps restant)
# dépasse son coût réel (VWAP + frais taker) d'au moins FV_MIN_EDGE. Toutes optionnelles.
FV_MIN_EDGE=0.04
# Probabilité modèle minimale du côté acheté (win rate attendu ≥ cette valeur).
FV_MIN_PROB=0.60
# Vente anticipée si (bid − frais) > p_modèle + FV_EXIT_EDGE (défaut = FV_MIN_EDGE).
# FV_EXIT_EDGE=0.04
# Fenêtre d'entrée en secondes restantes (pas d'entrée dans la fenêtre TWAP finale).
FV_MIN_TAU_SEC=45
FV_MAX_TAU_SEC=270
# Bornes d'ask achetable.
FV_MIN_ASK=0.08
FV_MAX_ASK=0.92
# Frais taker crypto_fees_v2, incertitude de flux (bps), loi (normal|t4), scrutation (s).
FV_TAKER_FEE_RATE=0.07
FV_BASIS_BPS=2
# Avancé (laisser par défaut) : bruit du strike en s, fenêtre de moyenne finale en s (0 = résolution ponctuelle).
# FV_STRIKE_NOISE_SEC=10
# FV_TWAP_WINDOW_SEC=0
FV_TAILS=normal
# Calibration (1 = modèle brut) : ne changer que sur suggestion de scripts/analysis/fv-report.ts.
FV_Z_SCALE=1
# Mélange avec le carnet : logit(p) = FV_BLEND_MODEL·logit(p_modèle) + FV_BLEND_MARKET·logit(p_carnet).
# 1 / 0 = modèle seul. Ne changer que si fv-report.ts (section 1b) le valide hors échantillon.
FV_BLEND_MODEL=1
FV_BLEND_MARKET=0
FV_POLL_SEC=10
# Prix spot temps réel (WebSocket Binance) et seuil de réaction (points de base).
FV_SPOT_STREAM=true
FV_MOVE_BPS=3
# Journal de toutes les évaluations (~/.polymarket/journal) pour scripts/analysis/fv-report.ts.
FV_JOURNAL=true
# Coins tradés (défaut : BTC,ETH,SOL,XRP,DOGE).
# FV_COINS=BTC,ETH
# Latence d'exécution simulée (ms) : carnet relu avant de « remplir » un pari papier.
FV_FILL_DELAY_MS=1000
# Minimum d'un achat au marché Polymarket (USDC) ; un pari papier plus petit n'est pas pris.
FV_MIN_ORDER_USD=1

# ── Telegram (notifications intégrées au bot) ───────────────────
# Token de @BotFather et ton chat id (@userinfobot) ; un groupe commence par -100.
# Envoie /start à ton bot avant le premier lancement.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=false     # couper sans retirer le token
# TELEGRAM_SUMMARY_MIN=60    # bilan périodique (min)
# TELEGRAM_TZ=Europe/Paris
# Seuil de confiance du LLM pour accepter une décision (sinon HOLD).
DEEPSEEK_MIN_CONF=0.5

# ── Apprentissage & PnL résolu ──────────────────────────────────
# Chaque mise simulée est loguée dans ~/.polymarket/history.json (avec le
# conditionId). Le script paperbot-pnl.py résout chaque round via l'API
# Polymarket (vrai résultat Up/Down) et calcule le PnL RÉALISÉ (gain si win,
# -1€ si lose). paperbot-recap.py l'affiche dans le récap Telegram.
# ── Dashboard ───────────────────────────────────────────────────
# Local uniquement par défaut. À distance : tunnel SSH, ou DASHBOARD_HOST=0.0.0.0 + un jeton
# (puis ouvrir http://serveur:3001/?token=<jeton>). Sans jeton hors local : lecture seule.
# DASHBOARD_PORT=3001
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_TOKEN=
