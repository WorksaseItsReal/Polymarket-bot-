# Dependencies
node_modules/

# Build output
dist/

# Environment variables
# NOTE SECURITE : `.env` ET `.env.*` (sauvegardes .env.bak-*, .env.local, ...) peuvent
# contenir de VRAIES cles (Polymarket private key, tokens Discord, API keys).
# Seul `.env.example` (placeholders) est versionne. Ne jamais retirer ces regles.
.env
.env.*
!.env.example

# Logs applicatifs (peuvent contenir des dumps d'objets et des donnees de session)
*.log
logs/
paperbot.log
paperbot.error.log

# Données d'exécution écrites dans le dépôt par d'anciennes versions (aujourd'hui dans
# ~/.polymarket) : jamais versionnées, sinon elles bloquent les `git pull` sur le serveur.
data/

# Sauvegardes locales de donnees (historique de trades, registre PnL)
*.bak
*.bak-*
~/.polymarket/

